{
  "name": "mistakequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node service/index.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node tests/live-engines.mjs",
    "test:live:arcade": "node tests/live-arcade-browser.mjs",
    "test:live:grammar": "node tests/live-arcade-browser.mjs --grammar",
    "test:live:classic": "node tests/live-classic-browser.mjs",
    "test:classic:retry": "node tests/classic-retry-browser.mjs",
    "test:adventure:jump": "node tests/adventure-browser.mjs jump",
    "test:jump:board": "node tests/jump-board-browser.mjs",
    "test:live:jump": "node tests/live-adventures.mjs jump",
    "test:adventure:maze": "node tests/adventure-browser.mjs maze",
    "test:maze:board": "node tests/maze-board-browser.mjs",
    "test:live:maze": "node tests/live-adventures.mjs maze",
    "test:e2e": "node tests/browser.mjs",
    "test:arcade": "node tests/arcade-language-browser.mjs && node tests/runner-variety-browser.mjs && node tests/continuous-runner-browser.mjs && node tests/adaptive-rounds-browser.mjs && node tests/guided-radar-browser.mjs && node tests/classic-retry-browser.mjs && node tests/jump-board-browser.mjs && node tests/adventure-browser.mjs jump && node tests/maze-board-browser.mjs && node tests/adventure-browser.mjs maze",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Install-Engines.ps1"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
