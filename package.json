{
  "name": "mistakequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node service/index.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node tests/live-engines.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:arcade": "node tests/arcade-language-browser.mjs && node tests/runner-variety-browser.mjs && node tests/continuous-runner-browser.mjs && node tests/adaptive-rounds-browser.mjs",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Install-Engines.ps1"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
